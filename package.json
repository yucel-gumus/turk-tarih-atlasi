{
  "name": "turk-tarih-atlasi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "validate": "node scripts/validate.ts",
    "deploy": "npm run build && cd dist && rm -rf .git && git init -q && git checkout -q -b gh-pages && touch .nojekyll && git add -A && git commit -q -m deploy && git push -f git@github.com:yucel-gumus/turk-tarih-atlasi.git gh-pages"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.16.0",
